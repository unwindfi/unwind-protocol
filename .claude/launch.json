{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "unwind",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "ts-node",
        "scripts/server.ts"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "preview",
        "--",
        "--port",
        "4173"
      ],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "unwind-devnet",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "ts-node",
        "scripts/server.ts"
      ],
      "env": {
        "CLUSTER": "devnet",
        "RPC_URL": "https://api.devnet.solana.com"
      },
      "port": 3000
    },
    {
      "name": "web-testnet",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5180",
        "--strictPort"
      ],
      "env": {
        "API_PROXY": "https://api.unwindfi.xyz"
      },
      "port": 5180
    }
  ]
}
