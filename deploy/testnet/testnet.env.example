# Copy to /etc/unwind/testnet.env (chmod 600, owned by the unwind user).
CLUSTER=devnet
PORT=3000
# Dedicated devnet RPCs, comma separated; requests take turns across them and
# a key that answers 429 rests for a minute. The public endpoint throttles the
# crank. A single key can go in RPC_URL instead.
RPC_URLS=https://devnet.helius-rpc.com/?api-key=KEY_1,https://solana-devnet.g.alchemy.com/v2/KEY_2
# Where transaction confirmations subscribe. Free Helius keys refuse
# websockets, so on devnet this defaults to the public endpoint.
# RPC_WS_URL=wss://api.devnet.solana.com
# Where reads go when every key answers 429. Defaults to the public devnet
# endpoint.
# RPC_FALLBACK_URL=https://api.devnet.solana.com
# The only key mock_pyth accepts price posts from on devnet.
RELAY_KEYPAIR=/etc/unwind/relay.json
# Faucet limits. Test USDC per claim, devnet SOL per claim, SOL per day total.
FAUCET_USDC=10000
FAUCET_SOL=0.05
FAUCET_SOL_PER_DAY=5
# Below this the faucet stops sending SOL and the server warns.
AUTHORITY_SOL_FLOOR=1
# Optional: a Discord webhook that gets the low-balance warning.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Let pages served from localhost call this API from the browser. Off on
# the public server: a localhost page is anyone's local copy of the site.
# CORS_LOCALHOST=1
# How often the auction reads every batch while none holds an order.
# AUCTION_IDLE_MS=4000
