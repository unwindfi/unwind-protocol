# /etc/unwind/testers.env (mode 600, owned by unwind)
BASE_URL=https://www.unwindfi.xyz
API_URL=https://www.unwindfi.xyz
TESTERS_KEYS=/etc/unwind/testers.json
TESTERS_DATA=/opt/unwind-testers/data
TESTERS_STATE=/opt/unwind/.devnet-state.json
CONCURRENCY=2
TESTERS_USER=team
TESTERS_PASS=change-me
# Survey: every main route in both themes on desktop and phone, once per
# this many minutes (0 turns it off). Captures land in $TESTERS_DATA/survey.
SURVEY_EVERY_MIN=60
# Bearer token for the read-only review feed at /testers/api/review.
# Generate with `openssl rand -hex 32`; under 32 characters the feed refuses
# every request. Never commit a real one.
REVIEW_TOKEN=
# The dashboard grades the fleet Down when nothing started, ended or sent a
# transaction in this many minutes.
FLEET_DOWN_MIN=15
