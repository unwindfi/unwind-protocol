# /etc/unwind/testers.env (mode 600, owned by unwind)
BASE_URL=https://www.unwindfi.xyz
API_URL=https://www.unwindfi.xyz
TESTERS_KEYS=/etc/unwind/testers.json
TESTERS_DATA=/opt/unwind-testers/data
TESTERS_STATE=/opt/unwind/.devnet-state.json
CONCURRENCY=2
TESTERS_USER=team
TESTERS_PASS=change-me
# Survey: every main route in both themes on desktop and phone, once per
# this many minutes (0 turns it off). Captures land in $TESTERS_DATA/survey.
SURVEY_EVERY_MIN=60
# Bearer token for the read-only review feed at /testers/api/review.
# Generate with `openssl rand -hex 32`; under 32 characters the feed refuses
# every request. Never commit a real one.
REVIEW_TOKEN=
# The dashboard grades the fleet Down when nothing started, ended or sent a
# transaction in this many minutes.
FLEET_DOWN_MIN=15
# Checks (testers/checks/, see the README): the API pinger every
# API_HEALTH_EVERY_SEC, the deploy watcher every DEPLOY_POLL_SEC, the rest in
# workers' turns. 0 turns a periodic check off.
CHECKS_API_URL=https://api.unwindfi.xyz
API_HEALTH_EVERY_SEC=300
DEPLOY_POLL_SEC=60
NUMBERS_EVERY_MIN=30
STALE_EVERY_MIN=30
WALLET_EDGES_EVERY_MIN=240
LINKS_EVERY_HOURS=24
# A wallet with test USDC and no SOL for the zero-SOL trade (a JSON secret
# key, mode 600, outside the repo). Unset: a fresh, empty key each run.
UNFUNDED_KEY=
# Multi-visit journeys (see README, "Multi-visit journeys"); defaults shown.
# LIQ_PERSONA=t52
# LIQ_COLLATERAL_USD=12
# LISTINGS_PER_DAY=1
# FAUCET_CLAIMS_PER_DAY=1
