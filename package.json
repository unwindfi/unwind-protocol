    "localnet": "./scripts/localnet.sh",
    "bootstrap": "ts-node scripts/bootstrap-localnet.ts",
    "dev": "ts-node scripts/server.ts",
    "gen:logos": "ts-node scripts/gen-logos.ts",
    "gen:brand": "ts-node scripts/gen-brand.ts",
    "gen:icons": "ts-node scripts/gen-icons.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@fontsource/inter": "^5.3.0",
    "@meteora-ag/dlmm": "^1.9.14",
    "@pythnetwork/pyth-solana-receiver": "^0.8.0",
    "@solana/spl-token": "^0.4.9",
    "express": "^5.2.1",
    "lightweight-charts": "^5.2.1",
    "lucide-static": "^1.47.0",
    "simple-icons": "^16.31.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/express": "^5.0.6",
    "@types/mocha": "^9.0.0",
    "@types/node": "^26.6.2",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^4.3.5"
  }
}
